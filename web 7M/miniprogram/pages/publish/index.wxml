<view class="page"><view class="section-title">给闲置一个新去处</view><view class="notice">模拟试用 · 发布需要三张不同角度实拍图</view><form bindsubmit="submit"><view class="panel"><view class="field"><text>标题</text><input name="title" maxlength="80" placeholder="如：数据结构 第二版"/></view><view class="field"><text>分类</text><picker range="{{['二手书','宿舍生活','运动闲置','电子产品']}}" bindchange="category">{{category==='books'?'二手书':category==='living'?'宿舍生活':category==='sports'?'运动闲置':'电子产品'}}</picker></view><view class="field"><text>商品介绍与缺陷</text><textarea name="description" maxlength="3000"/></view><view class="field"><text>售价（元，建议4元起，允许免费送）</text><input name="price" type="digit"/></view><view class="field"><text>原购买价（元，可不填）</text><input name="original_price" type="digit" placeholder="填了会显示折扣"/></view><view class="field"><text>成色</text><picker range="{{conditionOptions}}" data-list="conditionOptions" data-field="condition" bindchange="choose">{{condition}}</picker></view><view class="photos"><view class="photo" data-angle="front" bindtap="pick"><image wx:if="{{photos.front}}" src="{{photos.front}}"/><text>正面 ＋</text></view><view class="photo" data-angle="side" bindtap="pick"><image wx:if="{{photos.side}}" src="{{photos.side}}"/><text>侧面 ＋</text></view><view class="photo" data-angle="top" bindtap="pick"><image wx:if="{{photos.top}}" src="{{photos.top}}"/><text>顶部 ＋</text></view></view></view><view class="panel" wx:if="{{category==='books'}}"><view class="field"><text>版次</text><picker range="{{editions}}" data-list="editions" data-field="edition" bindchange="choose">{{edition}}</picker></view><view class="field"><text>出版社（不确定填待确认）</text><input name="publisher"/></view><view class="field"><text>作者</text><input name="author"/></view><view class="field"><text>ISBN（可选）</text><input name="isbn"/></view><view class="field"><text>笔记情况</text><picker range="{{notesOptions}}" data-list="notesOptions" data-field="notes" bindchange="choose">{{notes}}</picker></view><view class="field"><text>缺页情况</text><picker range="{{missingOptions}}" data-list="missingOptions" data-field="missing" bindchange="choose">{{missing}}</picker></view><view class="field"><text>附件情况</text><picker range="{{accessoryOptions}}" data-list="accessoryOptions" data-field="accessories" bindchange="choose">{{accessories}}</picker></view></view><view class="panel"><view class="field"><text>交付方式</text><picker range="{{['自提或送货','仅自提','仅送货']}}" bindchange="delivery">{{delivery==='both'?'自提或送货':delivery==='pickup'?'仅自提':'仅送货'}}</picker></view><view class="field"><text>公共交付区域</text><input name="region" placeholder="如 A1楼下入口"/></view><view class="field"><text>送货费（元，自提不收）</text><input name="delivery_fee" type="digit" value="2"/></view><view class="field"><text>购买时间（可填未知）</text><input name="bought" placeholder="2024-09 或未知"/></view></view><button class="primary" form-type="submit" loading="{{busy}}" disabled="{{busy}}">确认发布</button></form></view>
