<view class="page"><view class="brand">校园互助</view><view class="notice">发布需求＋私聊协商，不创建服务订单、不真实收款。取件码、手机号请勿公开。</view>
<view class="stack"><button class="primary" bindtap="publish">发布需求／提供服务</button><button wx:if="{{user}}" bindtap="mine">{{mine?'查看招募中':'我的发布'}}</button></view>
<view class="panel" wx:if="{{writing}}"><form bindsubmit="submit"><picker range="{{['我需要帮助','我提供服务']}}" value="{{kind}}" bindchange="pickKind"><view class="field">{{kind?'我提供服务':'我需要帮助'}}</view></picker><picker range="{{typeNames}}" value="{{category}}" bindchange="pickType"><view class="field">{{typeNames[category]}}</view></picker><view class="field"><input name="title" maxlength="80" placeholder="互助标题"/></view><view class="field"><input name="reward_yuan" type="digit" placeholder="意向报酬（元，留空面议，0无偿）"/></view><view class="field"><input name="place" maxlength="120" placeholder="公共地点，不写宿舍房号"/></view><picker mode="date" value="{{date}}" bindchange="pickDate"><view class="field">截止日期 {{date}}</view></picker><picker mode="time" value="{{clock}}" bindchange="pickTime"><view class="field">截止时间 {{clock}}（北京时间）</view></picker><textarea name="body" maxlength="2000" placeholder="说明时间、物品大小等，取件码私聊"/><button class="primary" form-type="submit">确认发布</button><button bindtap="cancel">取消编辑</button></form></view>
<view class="panel" wx:for="{{items}}" wx:key="id"><view class="row between"><text class="pill">{{item.service_label}}</text><text>{{item.statusText}}</text></view><view class="section-title">{{item.title}}</view><view>{{item.body}}</view><view class="price">{{item.rewardText}}</view><view class="muted">{{item.nickname}} · {{item.place}}<br/>截止 {{item.deadlineText}}</view><button wx:if="{{!item.is_owner&&item.status==='open'}}" class="primary" bindtap="contact" data-user="{{item.user_id}}">私聊协商</button><button wx:if="{{item.is_owner&&item.status!=='expired'}}" data-id="{{item.id}}" data-status="{{item.status==='open'?'closed':'open'}}" bindtap="status">{{item.status==='open'?'关闭需求':'重新开放'}}</button><view class="stack"><button data-id="{{item.id}}" data-type="other" bindtap="feedback">客服反馈</button><button data-id="{{item.id}}" data-type="report" bindtap="feedback">举报</button></view></view><view class="muted" wx:if="{{!items.length}}">暂无互助信息</view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button></view>
