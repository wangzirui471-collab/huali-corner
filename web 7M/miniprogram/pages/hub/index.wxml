<view class="page"><view class="brand">华立转角</view><view class="notice">本地模拟试用 · 客服08:00—20:00</view><view class="tabs"><button data-tab="me" bindtap="nav">我的</button><button data-tab="orders" bindtap="nav">订单</button><button data-tab="listings" bindtap="nav">我发布的</button><button data-tab="community" bindtap="nav">社区</button><button data-tab="messages" bindtap="nav">消息</button><button data-tab="support" bindtap="nav">客服</button><button data-tab="favorites" bindtap="nav">收藏</button></view>
<block wx:if="{{tab==='me'}}"><view class="panel" wx:if="{{!user}}"><block wx:if="{{authMode==='password'}}"><view class="section-title">计算机工程学院试用</view><view class="muted">账号未验证，仅作登录用，不作为实名或学籍认证。交易付款均为模拟。密码找回和修改可使用网页。</view><view class="stack"><button data-mode="login" bindtap="authView">账号登录</button><button data-mode="register" bindtap="authView">注册账号</button></view><form bindsubmit="login"><view class="field"><input name="phone" type="text" maxlength="120" placeholder="手机号或邮箱"/></view><view class="field" wx:if="{{authView==='register'}}"><input name="nickname" maxlength="24" placeholder="昵称"/></view><view class="field"><input name="password" password maxlength="128" placeholder="密码（6至128个字符）"/></view><block wx:if="{{authView==='register'}}"><view class="field"><input name="password_confirm" password maxlength="128" placeholder="再次输入密码"/></view><checkbox-group name="agree"><label><checkbox value="yes"/>已了解模拟交易与必要账号数据保存；不填写身份证、宿舍房号或支付信息。</label></checkbox-group></block><button form-type="submit" class="primary">{{authView==='register'?'注册并登录':'登录'}}</button></form></block><block wx:else><view class="section-title">手机号即可注册</view><view class="muted">无需证明学生身份，毕业生也欢迎。当前测试验证码不会发送短信。</view><form bindsubmit="login"><view class="field"><input name="phone" type="number" maxlength="11" placeholder="手机号" bindinput="code"/></view><view class="row"><input name="code" value="{{code}}" placeholder="测试验证码"/><button bindtap="sendCode">获取</button></view><button form-type="submit" class="primary">登录 / 注册</button></form><view class="stack"><button data-phone="13800000001" bindtap="demo">卖家体验</button><button data-phone="13800000002" bindtap="demo">买家体验</button><button data-phone="13800000003" bindtap="demo">客服体验</button></view></block><view class="muted">后端：{{baseURL}}</view><button class="small" bindtap="setBase">设置后端地址</button></view><view wx:else><view class="panel"><view class="section-title">{{user.nickname}}</view><view class="pill">信誉 {{user.score}}/100</view><view class="muted">低于60分暂停发布，处罚可申诉。</view></view><form class="panel" bindsubmit="saveProfile"><view class="field"><text>昵称</text><input name="nickname" value="{{user.nickname}}"/></view><view class="field"><text>学院（自填）</text><input name="college" value="{{user.college}}"/></view><view class="field"><text>专业</text><input name="major" value="{{user.major}}"/></view><view class="field"><text>简介</text><textarea name="bio" value="{{user.bio}}"/></view><button class="primary" form-type="submit">保存资料</button></form><button wx:if="{{user.role==='admin'||user.role==='support'}}" data-tab="staff" bindtap="nav">客服工作台</button><button bindtap="logout">退出登录</button></view></block>
<block wx:if="{{tab==='profile'}}"><view class="panel"><view class="section-title">{{profile.nickname}}</view><view class="muted">{{profile.college}} · {{profile.education}} · 信誉{{profile.score}}/100</view><view>{{profile.bio}}</view></view></block>
<block wx:if="{{tab==='profile'||tab==='favorites'}}"><view class="panel" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="title">{{item.title}}</view><view class="price">¥{{item.priceText}}</view><view class="muted">{{item.region}}</view></view></block>
<block wx:if="{{tab==='community'}}"><view class="panel"><view class="section-title">找到同频的同学</view><view class="stack"><button class="primary" data-kind="general" bindtap="join">加入总聊</button><button data-kind="college" bindtap="join">加入学院群（每群500人）</button></view></view><form class="panel" bindsubmit="post"><textarea name="body" value="{{postText}}" placeholder="求购、交流、毕业季的故事…"/><button class="primary" form-type="submit">发布帖子</button></form><view class="panel" wx:for="{{posts}}" wx:key="id"><view class="title">{{item.nickname}} · {{item.topic}}</view><view class="muted">{{item.body}}</view></view></block>
<block wx:if="{{tab==='messages'}}"><view wx:if="{{!user}}" class="panel">请先在我的页面登录</view><view class="tabs"><button wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="selectRoom">{{item.name}}</button></view><block wx:if="{{currentRoom}}"><scroll-view scroll-y class="panel chat"><view class="message {{item.user_id===user.id?'mine':''}}" wx:for="{{messages}}" wx:key="id"><view class="muted">{{item.nickname}}</view><view>{{item.body}}</view></view></scroll-view><form class="row" bindsubmit="message"><input name="body" value="{{messageText}}" placeholder="友善交流…"/><button class="primary" form-type="submit">发送</button></form></block></block>
<block wx:if="{{tab==='cart'}}"><view class="panel" wx:for="{{cart}}" wx:key="id"><view class="title">{{item.title}}</view><view class="price">¥{{item.priceText}}</view><view class="muted">{{item.nickname}} · {{item.region}}</view></view><form wx:if="{{cart.length}}" class="panel" bindsubmit="checkout"><view class="muted">仅支持同卖家合并，送货只收一次最高费用，最终总价在生成订单后、模拟付款前确认。</view><view class="field"><text>交付方式</text><picker range="{{['自提','卖家送货']}}" bindchange="delivery">{{delivery==='pickup'?'自提':'卖家送货'}}</picker></view><view class="field"><text>送货公共收货点（自提无需填）</text><input name="address"/></view><view class="field"><text>日期</text><picker mode="date" value="{{date}}" bindchange="date">{{date}}</picker></view><view class="field"><text>时间</text><picker mode="time" value="{{clock}}" bindchange="clock">{{clock}}</picker></view><button class="primary" form-type="submit">生成模拟订单</button></form></block>
<block wx:if="{{tab==='orders'}}"><view class="panel" wx:for="{{orders}}" wx:key="id"><view class="row between"><view class="title">订单 #{{item.id}}</view><text class="pill">{{item.statusText}}</text></view><view class="muted" wx:for="{{item.items}}" wx:for-item="product" wx:key="id">{{product.title}} · {{product.edition}}</view><view class="price">合计 ¥{{item.totalText}}</view><view class="muted">{{item.deliveryText}} · {{item.location}}<br/>约定：{{item.appointmentText}}（北京时间）<br/>交易对方：{{item.counterparty}}</view><view class="muted">交付前检查实物、笔记、缺页和附件。资金均为模拟记录。</view><view wx:for="{{item.changes}}" wx:for-item="change" wx:key="id" class="notice"><view>{{change.timeText}} · {{change.address}} · {{change.status}}</view><view wx:if="{{change.canRespond}}"><button data-id="{{change.id}}" data-accept="yes" bindtap="change">接受改约</button><button data-id="{{change.id}}" data-accept="no" bindtap="change">拒绝改约</button></view></view><view class="stack"><button wx:if="{{!item.isBuyer&&item.status==='paid'&&!item.schedule_confirmed}}" data-id="{{item.id}}" data-action="confirm_schedule" bindtap="orderAction">确认交付时间</button><button wx:if="{{item.status==='paid'||item.status==='awaiting_handover'}}" data-id="{{item.id}}" bindtap="propose">申请改约</button><button wx:if="{{item.isBuyer&&item.status==='awaiting_payment'}}" data-id="{{item.id}}" data-action="pay" bindtap="orderAction" class="primary">模拟付款</button><button wx:if="{{item.status==='awaiting_payment'}}" data-id="{{item.id}}" bindtap="editOrder">修改订单</button><button wx:if="{{item.isBuyer&&(item.status==='awaiting_payment'||item.status==='paid')}}" data-id="{{item.id}}" data-action="cancel" bindtap="orderAction">取消订单</button><button wx:if="{{!item.isBuyer&&item.status==='paid'}}" data-id="{{item.id}}" data-action="deliver" bindtap="orderAction">标记交付</button><button wx:if="{{item.isBuyer&&item.status==='awaiting_handover'}}" data-id="{{item.id}}" data-action="handover" bindtap="orderAction">核对交接，开始24小时计时</button><button wx:if="{{item.isBuyer&&(item.status==='awaiting_receipt'||item.status==='awaiting_handover')}}" data-id="{{item.id}}" data-action="receive" bindtap="orderAction" class="primary">确认收货</button><button wx:if="{{item.isBuyer&&(item.status==='paid'||item.status==='awaiting_receipt'||item.status==='awaiting_handover'||item.status==='completed')}}" data-id="{{item.id}}" bindtap="ticket">申请售后</button></view></view></block>
<block wx:if="{{tab==='listings'}}"><view class="stats-row" wx:if="{{listingStats.length}}"><view class="stat" wx:for="{{listingStats}}" wx:key="label"><text class="num">{{item.count}}</text><text>{{item.label}}</text></view></view><view class="panel" wx:for="{{listings}}" wx:key="id"><view class="row between"><view class="title">{{item.title}}</view><text class="pill">{{item.statusText}}</text></view><view class="price">¥{{item.priceText}}</view><view class="muted">{{item.region}} · {{item.delivery==='pickup'?'仅自提':item.delivery==='delivery'?'卖家送货':'自提/送货'}}</view><view class="stack"><button wx:if="{{item.status==='available'}}" data-id="{{item.id}}" data-action="delist" bindtap="listAction">下架</button><button wx:if="{{item.status==='removed'}}" data-id="{{item.id}}" data-action="relist" bindtap="listAction" class="primary">重新上架</button><button wx:if="{{item.status==='reserved'||item.status==='sold'}}" class="small">已关联订单</button></view></view><view class="panel" wx:if="{{!listings.length}}"><view class="muted">还没有发布商品。下架不会删除，随时可以重新上架。</view><button class="primary" data-tab="publish" bindtap="nav">去发布第一件</button></view></block>
<block wx:if="{{tab==='support'||tab==='staff'}}"><button class="primary" bindtap="ticket">提交问题</button><view class="panel" wx:for="{{tickets}}" wx:key="id" data-id="{{item.id}}" bindtap="openTicket"><view class="row between"><view class="title">{{item.subject}}</view><text class="pill">{{item.statusText}}</text></view><view class="muted">{{item.body}}</view></view><view class="panel" wx:if="{{activeTicket}}"><view class="section-title">{{activeTicket.subject}}</view><view>{{activeTicket.body}}</view><view class="muted">{{activeTicket.reason}}</view><view class="message" wx:for="{{activeTicket.messages}}" wx:key="id"><view class="muted">{{item.nickname}}</view>{{item.body}}</view><form bindsubmit="replyTicket"><textarea name="body" placeholder="补充材料或回复"/><button form-type="submit">发送回复</button></form><view wx:if="{{tab==='staff'}}" class="stack"><button data-action="claim" bindtap="resolve">认领</button><button data-action="review" bindtap="resolve">提交复核</button><button wx:if="{{activeTicket.type==='refund'}}" data-action="refund" bindtap="resolve">审核模拟退款</button><button data-action="resolved" bindtap="resolve">协商完成结案</button></view></view></block></view>
