                  "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.collectionVariables.get('maxLatencyMs')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"怎么退款\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/reply",
              "host": ["{{baseUrl}}"],
              "path": ["reply"]
            },
            "description": "退款属于 FAQ 覆盖范围：必须命中资料，答案不能空。"
          }
        },
