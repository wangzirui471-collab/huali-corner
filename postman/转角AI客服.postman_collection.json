{
  "info": {
    "name": "转角AI客服 · 接口自动化",
    "description": "针对本地 AI 客服服务（ai_service/server.py，默认 127.0.0.1:8093）的接口自动化用例。\n\n用法：Postman 里 Import 本文件 → 右上角选环境「转角-本地8093」→ Collection Runner 或 newman 跑。\n覆盖：健康检查、问答主链路（问候/业务/转人工/兜底/多轮）、发布助手（描述/估价）、容错与鉴权。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8093" },
    { "key": "token", "value": "" },
    { "key": "maxLatencyMs", "value": "15000" },
    { "key": "aiMode", "value": "" },
    { "key": "faqTitle", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// —— 集合级前置脚本：每个请求发送前都会执行 ——",
          "// 1) 配了 token 才注入鉴权头（服务端没设 HC_AI_TOKEN 时不加，加了也无害）",
          "const token = pm.variables.get('token');",
          "if (token) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}",
          "// 2) baseUrl 末尾斜杠统一去掉，避免拼出 //health 这种路径",
          "const base = String(pm.variables.get('baseUrl') || '').replace(/\\/+$/, '');",
          "if (base) { pm.variables.set('baseUrl', base); }",
          "console.log('[→] ' + pm.request.method + ' ' + base + (pm.request.url.getPath ? pm.request.url.getPath() : ''));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 · 连通性（先确认服务活着）",
      "item": [
        {
          "name": "01 健康检查 · GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('ok 为 true', () => pm.expect(body.ok).to.eql(true));",
                  "",
                  "pm.test('知识库已索引（chunks > 0）', () => {",
                  "    pm.expect(body.chunks).to.be.a('number');",
                  "    pm.expect(body.chunks).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('运行模式是 mock 或 llm', () => {",
                  "    pm.expect(body.mode).to.be.oneOf(['mock', 'llm']);",
                  "});",
                  "",
                  "pm.test('provider / model 非空', () => {",
                  "    pm.expect(body.provider).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.model).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "// 把状态存进集合变量，后续用例可以直接引用",
                  "pm.collectionVariables.set('aiMode', body.mode);",
                  "pm.collectionVariables.set('aiChunks', body.chunks);",
                  "console.log('[health] mode=' + body.mode + ' chunks=' + body.chunks + ' provider=' + body.provider);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "不需要鉴权。返回索引条数、运行模式、模型名——所有下游用例的前提。"
          }
        }
      ]
    },
    {
      "name": "10 · 问答主链路 · POST /reply",
      "item": [
        {
          "name": "02 打招呼（问候分流，不检索不花钱）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('action = reply（不转人工）', () => pm.expect(body.action).to.eql('reply'));",
                  "",
                  "pm.test('mode = rule（问候走规则，不调用模型）', () => pm.expect(body.mode).to.eql('rule'));",
                  "",
                  "pm.test('sources 为空（不查知识库）', () => {",
                  "    pm.expect(body.sources).to.be.an('array').that.is.empty;",
                  "});",
                  "",
                  "pm.test('answer 有内容', () => {",
                  "    pm.expect(body.answer).to.be.a('string');",
                  "    pm.expect(body.answer.length).to.be.above(2);",
                  "});",
                  "",
                  "pm.test('返回客服在线状态（support）', () => {",
                  "    pm.expect(body.support).to.be.an('object');",
                  "    pm.expect(body.support.hours).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"你好\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/reply",
              "host": ["{{baseUrl}}"],
              "path": ["reply"]
            },
            "description": "问候语应被规则分流：秒回、不检索、不花 token。"
          }
        },
        {
          "name": "03 业务问题（命中知识库）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('action = reply', () => pm.expect(body.action).to.eql('reply'));",
                  "",
                  "pm.test('命中知识库（sources 非空）', () => {",
                  "    pm.expect(body.sources).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('第一条来源有标题且分数过阈值', () => {",
                  "    const top = body.sources[0];",
                  "    pm.expect(top.title).to.be.a('string').and.not.empty;",
                  "    pm.expect(top.score).to.be.above(0.11);   // 服务端 HC_AI_MIN_SCORE 默认 0.12",
                  "    pm.collectionVariables.set('faqTitle', top.title);",
                  "});",
                  "",
                  "pm.test('answer 不是空话', () => {",
                  "    pm.expect(body.answer).to.be.a('string');",
