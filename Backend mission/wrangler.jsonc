{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuanjiao",
  "main": "worker.py",
  "account_id": "824c84ca5e382e2b4f8de6260d6b0017",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "../web 7M",
    "binding": "ASSETS",
    // 只有 API 和图片进 Python（Pyodide 冷启动重，静态资源绝不能绕这一圈）。
    // CSS/JS/HTML 直接由边缘 CDN 输出，毫秒级。
    "run_worker_first": ["/api/*", "/media/*"],
    // SPA 回退：没有对应文件的路径（如 /login）直接回 index.html，
    // 不再依赖 Python 里的 assets.fetch。
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "zhuanjiao-trial-db",
    "database_id": "530fa313-3285-42b9-aebd-e65e9b4e86ed",
    "remote": true
  }],
  "r2_buckets": [{
    "binding": "MEDIA",
    "bucket_name": "zhuanjiao-trial-images",
    "remote": true
  }]
}
