{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuanjiao",
  "main": "worker.py",
  "account_id": "824c84ca5e382e2b4f8de6260d6b0017",
  "compatibility_date": "2026-10-17",
  // 当前直用 Wrangler 打包，显式使用平台内置 Python SDK；不降低兼容日期或 TLS 校验。
  // 否则新运行时默认要求随包提供 external SDK，导入 workers 会在发布校验时报 10021。
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "observability": {
    "logs": {"enabled": true, "invocation_logs": true}
  },
  // AI 客服：模型名用官方 deepseek-flash（DeepSeek-V4.1-Flash）；
  // API Key 不进仓库，用 `wrangler secret put HC_AI_API_KEY` 单独设置。
  "vars": {
    "HC_AI_MODEL": "deepseek-flash",
    // 所有者（L1）可用更强的模型；留空则回退 HC_AI_MODEL。
    // 例：在 Cloudflare 控制台/`wrangler secret put` 设为你的套餐支持的模型名。
    "HC_AI_MODEL_OWNER": "",
    "HC_AI_API_URL": "https://api.deepseek.com/chat/completions",
    "HC_AI_DAILY_LIMIT": "30"
  },
  "assets": {
    "directory": "../web 7M",
    "binding": "ASSETS",
    // 只有 API 和图片进 Python（Pyodide 冷启动重，静态资源绝不能绕这一圈）。
    // CSS/JS/HTML 直接由边缘 CDN 输出，毫秒级。
    "run_worker_first": ["/api/*", "/media/*"],
    // SPA 回退：没有对应文件的路径（如 /login）直接回 index.html，
    // 不再依赖 Python 里的 assets.fetch。
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "zhuanjiao-trial-db",
    "database_id": "530fa313-3285-42b9-aebd-e65e9b4e86ed",
    "remote": true
  }],
  // 服务端短 TTL 缓存（Cloudflare KV，最接近 Redis 的原生键值存储）。
  // 只缓存匿名首屏列表，按路径+查询串做键；写失败/读失败都 fail-open。
  "kv_namespaces": [{
    "binding": "CACHE",
    "id": "1d1bd586ea3d402e82a7e48b3ff23da0"
  }],
  "triggers": {"crons": ["*/5 * * * *"]},
  "r2_buckets": [{
    "binding": "MEDIA",
    "bucket_name": "zhuanjiao-trial-images",
    "remote": true
  }]
}
