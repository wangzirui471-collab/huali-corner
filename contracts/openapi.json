          }
        },
        "summary": "Password Parameters",
        "tags": [
          "compat-identity-trade"
        ]
      }
    },
    "/api/v1/compat/checkout": {
      "post": {
        "description": "原请求键只转发一次；头与正文不一致时拒绝，不在网络异常后自动生成新键。",
        "operationId": "checkout_api_v1_compat_checkout_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
