    "/api/v1/compat/order": {
      "get": {
        "description": "按编号查询详情，交易方、客服或其他身份的可见范围仍由旧服务核验。",
        "operationId": "order_api_v1_compat_order_get",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "title": "Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
