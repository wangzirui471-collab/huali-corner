      "get": {
        "description": "原样返回现有盐与 KDF 轮数，不把不存在账号与已存在账号作额外区分。",
        "operationId": "password_parameters_api_v1_compat_auth_salt_get",
        "parameters": [
          {
            "in": "query",
            "name": "phone",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 120,
