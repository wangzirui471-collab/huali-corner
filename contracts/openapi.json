    "/api/v1/compat/order/action": {
      "post": {
        "description": "买卖双方动作沿用旧状态机，不根据页面按钮直接改变订单字段。",
        "operationId": "order_action_api_v1_compat_order_action_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionInput"
              }
            }
          },
          "required": true
