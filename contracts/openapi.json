{
  "components": {
    "schemas": {
      "ActionInput": {
        "additionalProperties": false,
        "description": "动作白名单仅选择旧用例；退款仍通过既有售后工单办理。",
        "properties": {
          "action": {
            "enum": [
              "pay",
              "cancel",
              "confirm_schedule",
              "deliver",
              "handover",
              "receive",
              "reschedule"
            ],
            "title": "Action",
            "type": "string"
          },
          "address": {
            "anyOf": [
              {
                "maxLength": 150,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "appointment": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ],
                "ge": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Appointment"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "action"
        ],
        "title": "ActionInput",
        "type": "object"
      },
      "AnswerData": {
        "description": "问答结果保留轮次，答案、来源和转人工建议均为只读数据。",
        "properties": {
          "answer_text": {
            "title": "Answer Text",
            "type": "string"
          },
          "client_turn_id": {
            "title": "Client Turn Id",
            "type": "string"
          },
          "handoff": {
            "$ref": "#/components/schemas/Handoff"
          },
          "mode": {
            "enum": [
              "mock",
              "llm",
              "handoff"
            ],
            "title": "Mode",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "client_turn_id",
          "answer_text",
          "mode",
          "sources",
          "handoff"
        ],
        "title": "AnswerData",
        "type": "object"
      },
      "AnswerInput": {
        "additionalProperties": false,
        "description": "同一问题显式重试沿用 UUID；不接受 history、role 或上下文。",
        "properties": {
          "client_turn_id": {
            "format": "uuid",
            "title": "Client Turn Id",
            "type": "string"
          },
          "question": {
            "maxLength": 800,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "client_turn_id",
          "question"
        ],
        "title": "AnswerInput",
        "type": "object"
      },
      "ChangeInput": {
        "additionalProperties": false,
        "description": "只允许对已有改约作出决定，不接受客户端指定审批人。",
        "properties": {
          "accept": {
            "title": "Accept",
            "type": "boolean"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "accept"
        ],
        "title": "ChangeInput",
        "type": "object"
      },
      "CheckoutInput": {
        "additionalProperties": false,
        "description": "下单只接收商品、预约和原请求键，价格、卖家与状态均由旧 writer 决定。",
        "properties": {
          "address": {
            "default": "",
            "maxLength": 150,
            "title": "Address",
            "type": "string"
          },
          "appointment": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "ge": 0,
            "title": "Appointment"
          },
          "delivery": {
            "enum": [
              "pickup",
              "delivery"
            ],
            "title": "Delivery",
            "type": "string"
          },
          "key": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "product_ids": {
            "items": {
              "exclusiveMinimum": 0.0,
              "maximum": 9007199254740991.0,
              "type": "integer"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Product Ids",
            "type": "array"
          },
          "want_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 9007199254740991.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Want Id"
          }
        },
        "required": [
          "product_ids",
          "key",
          "delivery",
          "appointment"
        ],
        "title": "CheckoutInput",
        "type": "object"
      },
      "Envelope_AnswerData_": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnswerData"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/Metadata"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "Envelope[AnswerData]",
        "type": "object"
      },
      "Envelope_HealthData_": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthData"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/Metadata"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "Envelope[HealthData]",
        "type": "object"
      },
      "Envelope_JsonValue_": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JsonValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/Metadata"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "Envelope[JsonValue]",
        "type": "object"
      },
      "Envelope_NoneType_": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "data": {
            "title": "Data",
            "type": "null"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/Metadata"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "Envelope[NoneType]",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "失败时附带的结构化信息，暂时只包含字段校验结果。",
        "properties": {
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldIssue"
            },
            "title": "Fields",
            "type": "array"
          }
        },
        "title": "ErrorDetail",
        "type": "object"
      },
      "FieldIssue": {
        "description": "字段路径和安全展示文案，不回显密码或数据库错误。",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "FieldIssue",
        "type": "object"
      },
      "Handoff": {
        "description": "建议人工入口只导航到工单草稿，不表示已创建工单或分配客服。",
        "properties": {
          "next_path": {
            "const": "/support/new",
            "default": "/support/new",
            "title": "Next Path",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "recommended": {
            "title": "Recommended",
            "type": "boolean"
          }
        },
        "required": [
          "recommended"
        ],
        "title": "Handoff",
        "type": "object"
      },
      "HealthData": {
        "description": "健康检查只证明新服务存活，business_ready 不冒充业务迁移已完成。",
        "properties": {
          "business_ready": {
            "const": false,
            "default": false,
            "title": "Business Ready",
            "type": "boolean"
          },
          "compat_enabled": {
            "default": false,
            "title": "Compat Enabled",
            "type": "boolean"
          },
          "environment": {
            "enum": [
              "local",
              "test",
              "production"
            ],
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "environment"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "JsonValue": {},
      "LoginInput": {
        "additionalProperties": false,
        "description": "兼容旧明文口令模式或客户端 KDF 摘要模式，严格二选一。",
        "properties": {
          "digest": {
            "anyOf": [
              {
                "pattern": "^[0-9a-fA-F]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Digest"
          },
          "password": {
            "anyOf": [
              {
                "format": "password",
                "maxLength": 128,
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "phone": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "LoginInput",
        "type": "object"
      },
      "Metadata": {
        "description": "协议版本与模拟交易标记；后续兼容转换据此选择 mapper。",
        "properties": {
          "schema_version": {
            "const": "v1",
            "default": "v1",
            "title": "Schema Version",
            "type": "string"
          },
          "simulation": {
            "const": true,
            "default": true,
            "title": "Simulation",
            "type": "boolean"
          }
        },
        "title": "Metadata",
        "type": "object"
      },
      "Source": {
        "description": "可信来源只由审核清单构造，正文供用户直接核对。",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "version",
          "content"
        ],
        "title": "Source",
        "type": "object"
      },
      "UpdateInput": {
        "additionalProperties": false,
        "description": "付款前修改仍由旧服务核验归属、状态与可变字段。",
        "properties": {
          "address": {
            "anyOf": [
              {
                "maxLength": 150,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "appointment": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "ge": 0,
            "title": "Appointment"
          },
          "delivery": {
            "anyOf": [
              {
                "enum": [
                  "pickup",
                  "delivery"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivery"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Id",
            "type": "integer"
          },
          "product_ids": {
            "anyOf": [
              {
                "items": {
                  "exclusiveMinimum": 0.0,
                  "maximum": 9007199254740991.0,
                  "type": "integer"
                },
                "maxItems": 20,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Ids"
          }
        },
        "required": [
          "id",
          "appointment"
        ],
        "title": "UpdateInput",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "华立转角 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/compat/auth/login": {
      "post": {
        "description": "只把已选择的凭据交给旧登录用例；本模块不保存密码或签发另一套 token。",
        "operationId": "login_api_v1_compat_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Login",
        "tags": [
          "compat-identity-trade"
        ]
      }
    },
    "/api/v1/compat/auth/logout": {
      "post": {
        "description": "撤销原会话，不仅清除本机页面的登录外观。",
        "operationId": "logout_api_v1_compat_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_JsonValue_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_NoneType_"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "compat-identity-trade"
        ]
      }
    },
